# ==============================================================================
# Gym SaaS — Environment Variables Template
# All production secrets must be securely configured in server environment.
# Never expose server-side secrets (Supabase secret keys, gateway keys) to the browser.
# ==============================================================================

# Supabase (Client Safe)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase (Server Only - Keep Secret)
SUPABASE_SERVICE_ROLE_KEY=

# Application URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_GYM_NAME=Gym SaaS

# Authorize.Net Gateway (Server Only - Keep Secret)
AUTHORIZENET_API_LOGIN_ID=
AUTHORIZENET_TRANSACTION_KEY=
AUTHORIZENET_SIGNATURE_KEY=
AUTHORIZENET_ENVIRONMENT=SANDBOX

# Cron Job Secret for Scheduled Tasks (Server Only - Keep Secret)
CRON_SECRET=

# Member QR Token Signing Secret (Server Only - Keep Secret)
QR_SIGNING_SECRET=
